# ============================================================
# App Configuration
# NOTE: NEXT_PUBLIC_* di-inline saat BUILD. Set sebagai
# build args di Docker (docker-compose.yml sudah dikonfigurasi).
# ============================================================
NEXT_PUBLIC_APP_URL=https://ibnuwm.com
NEXT_PUBLIC_GTM=GTM-XXXXXXX

# Data kontak publik (di-inline ke frontend)
NEXT_PUBLIC_EMAIL=email-anda@gmail.com
NEXT_PUBLIC_PHONE=+62 812-3456-7890
NEXT_PUBLIC_WHATSAPP=+6281234567890
NEXT_PUBLIC_ADDRESS=Jakarta Selatan, DKI Jakarta, Indonesia
NEXT_PUBLIC_OFFICE_ADDRESS=Jl. Contoh No. 123, Jakarta Selatan 12730
NEXT_PUBLIC_OFFICE_HOURS=Senin - Jumat: 09:00 - 18:00 WIB
NEXT_PUBLIC_RESUME_URL=https://drive.google.com/file/d/VIEW_KEY/view

# ============================================================
# Contact Form - reCAPTCHA v2 (wajib untuk proteksi anti-spam)
# Site key = publik (frontend), Secret key = server-only
# Daftar: https://www.google.com/recaptcha/admin
# ============================================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le-site-key
RECAPTCHA_SECRET_KEY=6Le-secret-key

# ============================================================
# Contact Form - Email (Gmail SMTP)
# ============================================================
EMAIL_ADDRESS=your-email@gmail.com
GMAIL_PASSKEY=your-gmail-app-password

# ============================================================
# Contact Form - Telegram Bot Notifications
# ============================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================================
# Analytics (Optional)
# ============================================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
